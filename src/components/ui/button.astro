---
interface Props {
  size?: "md" | "lg";
  block?: boolean;
  style?: "outline" | "primary" | "inverted";
  class?: string;
  [x: string]: any;
}

const {
  size = "md",
  style = "primary",
  block,
  class: className,
  ...rest
} = Astro.props;

const sizes = {
  md: "px-5 py-2.5",
  lg: "px-6 py-3",
};

const styles = {
  outline: "border border-neutral-300 hover:border-neutral-950 text-neutral-950",
  primary:
    "bg-neutral-950 text-white hover:bg-brand-600 shadow-lg shadow-brand-500/20 border border-transparent",
};
---

<button
  {...rest}
  class:list={[
    "inline-flex items-center justify-center gap-2 rounded-full font-medium text-center transition duration-200 hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 ring-offset-2 ring-brand-300",
    block && "w-full",
    sizes[size],
    styles[style],
    className,
  ]}
  ><slot />
</button>
