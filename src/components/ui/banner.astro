---
import { getLangFromUrl, useTranslations } from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div
  class="flex flex-row w-full lg:w-auto items-center justify-center bg-neutral-950 px-4 py-2">
  <p class="text-center text-xs sm:text-sm font-semibold tracking-wide text-white">
    <span class="mr-2 inline-block h-2 w-2 rounded-full bg-emerald-400 align-middle animate-pulse" aria-hidden="true"></span>
    {t("banner")}
  </p>
</div>
