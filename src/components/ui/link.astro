---
interface Props {
  href: string;
  size?: "md" | "lg";
  block?: boolean;
  style?: "outline" | "primary" | "inverted" | "muted";
  class?: string;
  [x: string]: any;
}

const {
  href,
  block,
  size = "lg",
  style = "primary",
  class: className,
  ...rest
} = Astro.props;

const sizes = {
  lg: "px-5 py-2.5",
  md: "px-4 py-2",
};

const styles = {
  outline: "bg-white border border-neutral-300 hover:border-neutral-950 text-neutral-950",
  primary: "bg-neutral-950 text-white hover:bg-brand-600 shadow-lg shadow-brand-500/20 border border-transparent",
  inverted: "bg-white text-neutral-950 hover:bg-brand-50 border border-transparent",
  muted: "bg-neutral-100 hover:bg-neutral-200 border border-transparent",
};
---

<a
  href={href}
  {...rest}
  class:list={[
    "inline-flex items-center justify-center gap-2 rounded-full font-medium text-center transition duration-200 hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 ring-offset-2 ring-brand-300",
    block && "w-full",
    sizes[size],
    styles[style],
    className,
  ]}
  ><slot />
</a>
