---
// @ts-ignore
import { Icon } from "astro-icon";
import Container from "./ui/container.astro";
import { getLangFromUrl, useTranslations } from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const icons = [
  "mdi:eye",
  "bx:bxs-star",
  "fluent:people-20-filled",
  "bi:info",
  "ion:card",
  "uil:user-exclamation",
];

const features = t("features.features").map((feature, index) => ({
  ...feature,
  icon: icons[index],
}));
---

<Container class="px-6 mt-24">
  <div
    class="mt-6 block max-w-5xl font-display text-3xl font-semibold tracking-tight text-neutral-950 [text-wrap:balance] sm:text-4xl">
    <h2>{t("features.primary")}</h2>
  </div>
  <div class="grid sm:grid-cols-2 md:grid-cols-3 mt-16 gap-6">
    {
      features.map((item) => (
        <div class="flex flex-col gap-4 items-start rounded-3xl border border-neutral-200 bg-white p-6 transition duration-300 hover:-translate-y-1 hover:border-brand-200 hover:shadow-xl hover:shadow-brand-500/10">
          <div class="bg-gradient-to-br from-brand-500 to-indigo-600 rounded-xl p-2 w-10 h-10 shrink-0">
            <Icon class="text-white" name={item.icon} />
          </div>
          <div>
            <h3 class="font-semibold text-lg">{item.title}</h3>{" "}
            <p
              class="text-slate-500 mt-2 leading-relaxed"
              set:html={item.description}
            />
          </div>
        </div>
      ))
    }
  </div>
</Container>
