---
import Background from "./background.astro";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import Link from "./ui/link.astro";

import { getRelativeLocaleUrl } from "astro:i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

interface Props {
  primaryText: string;
  secondaryText: string;
  tertiaryText?: string;
  quaternaryText?: string;
  cta?: {
    text: string;
    link: string;
  };
  slotClasses?: string;
}

const { primaryText, secondaryText, tertiaryText, quaternaryText, cta, slotClasses } =
  Astro.props;
---

<main class="relative pb-8 md:pb-32">
  <Background />
  <div class="mx-auto max-w-7xl px-6 lg:px-8 mt-16 sm:mt-24 lg:mt-32">
    <div
      class="flex flex-col lg:flex-row mx-auto max-w-2xl lg:max-w-none gap-20">
      <div class="mx-auto max-w-2xl lg:max-w-none lg:w-8/12">
        <span
          class="inline-flex items-center gap-2 rounded-full border border-brand-200 bg-white/80 px-3 py-1 text-sm font-medium text-brand-700 shadow-sm">
          <span class="text-amber-500" aria-hidden="true">★★★★★</span>
          {t("reviews.GMBscore")}/5 · Google
        </span>
        <h1
          class="mt-6 font-display text-5xl font-semibold tracking-tight text-gradient [text-wrap:balance] sm:text-7xl">
          {primaryText}
        </h1>
        <div class="font-display mt-6 max-w-3xl text-xl text-neutral-600">
          <p set:html={secondaryText} />
        </div>
        {
          tertiaryText && (
            <div class="font-display mt-6 max-w-3xl text-xl text-neutral-600">
              <p set:html={tertiaryText} />
            </div>
          )
        }
        {
          quaternaryText && (
            <div class="font-display mt-6 max-w-3xl text-xl text-neutral-600">
              <p set:html={quaternaryText} />
            </div>
          )
        }
        {
          cta && (
            <div class="flex mt-10 text-xl">
              <Link href={getRelativeLocaleUrl(lang, cta.link)}>
                {cta.text}
              </Link>
            </div>
          )
        }
      </div>
      <div class:list={["relative", slotClasses]}>
        <div
          aria-hidden="true"
          class="absolute inset-0 -z-10 m-auto h-3/4 w-3/4 rounded-full bg-gradient-to-tr from-brand-400/40 via-indigo-300/30 to-sky-300/40 blur-3xl">
        </div>
        <slot />
      </div>
    </div>
  </div>
</main>
